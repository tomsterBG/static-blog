<!DOCTYPE html>
<html lang="{{ language }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {# Use page title if available, otherwise site title #}
    <title>{{ title or site.title }}</title>
    {# Use page description if available #}
    {% if description %}
        <meta name="description" content="{{ description }}">
    {% endif %}
    <link rel="stylesheet" href="/assets/css/style.css">
    {# Add language alternate links for SEO #}
    {% set translationUrl = page | findTranslation(collections.posts_all) %}
    {% if translationUrl %}
        {% set currentLangData = site.languages | find(item => item.code == language) %}
        {% set translatedLangCode = (language == 'en') ? 'bg' : 'en' %}
        <link rel="alternate" hreflang="{{ translatedLangCode }}" href="{{ site.url }}{{ translationUrl }}">
    {% endif %}

    {# Analytics Script Placeholder #}
    {{ site.analytics | safe }}
</head>
<body>
    <header class="site-header">
        <a href="/{{ language }}/" class="site-title">{{ site.title }}</a>
        <nav>
            <ul class="language-switcher">
                {% set currentUrl = page.url %}
                {# Link to the other language version #}
                {% if translationUrl %}
                    {% set translatedLangCode = (language == 'en') ? 'bg' : 'en' %}
                    {% set translatedLangData = site.languages | find(item => item.code == translatedLangCode) %}
                     <li><a href="{{ translationUrl }}" lang="{{ translatedLangCode }}" hreflang="{{ translatedLangCode }}"> {{ translatedLangData.label }}</a></li>
                {% else %}
                   {# Show current language if no translation #}
                   {% set currentLangData = site.languages | find(item => item.code == language) %}
                   <li><span class="current-lang">{{ currentLangData.label }} (Current)</span></li>
                   {# Optionally show other language linked to its homepage #}
                   {% set otherLangCode = (language == 'en') ? 'bg' : 'en' %}
                   {% set otherLangData = site.languages | find(item => item.code == otherLangCode) %}
                   <li><a href="/{{ otherLangCode }}/" lang="{{ otherLangCode }}" hreflang="{{ otherLangCode }}">{{ otherLangData.label }}</a></li>
                {% endif %}
            </ul>
        </nav>
    </header>

    <main class="main-content">
        {# Main content block for specific pages #}
        {{ content | safe }}
    </main>

    <footer class="site-footer">
        <p>© {% now 'yyyy' %} {{ site.author }}. Content licensed under <a href="http://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a>. Code under MIT License.</p>
        <p>Built with <a href="https://www.11ty.dev/" target="_blank" rel="noopener noreferrer">Eleventy</a>.</p>
    </footer>

    {# Comments Script Placeholder - typically loaded at the end #}
    {% if layout == 'post.njk' %} {# Only load comments on post pages #}
        <div class="comments-section">
            {{ site.comments | safe }}
        </div>
    {% endif %}
</body>
</html>
