<!doctype html>
<html lang="{{ metadata.language }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/css/style.css"> {# Link to your future CSS file #}
</head>
<body style="background-color: #F5F5DC;"> {# Warm beige background #}
    {% include "header.njk" %}

