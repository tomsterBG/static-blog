<ul>
    {% for post in posts | excludeTag('hidden') %} {# Filter out posts with the 'hidden' tag #}
        <li>
            <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
            <p>Edited: {{ post.date | postDate }}</p> {# Will use a custom filter for date formatting #}
            <p>{{ post.data.tldr }}</p> {# TLDR text from front matter #}
            {% if post.data.tags %}
                {% for tag in post.data.tags | excludeTag('hidden') %} {# Show tags excluding 'hidden' #}
                    <span class="tag">{{ tag }}</span>
                {% endfor %}
            {% endif %}
        </li>
    {% endfor %}
</ul>
