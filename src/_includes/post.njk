---
# This front matter tells Eleventy to use base.njk as the layout *for this layout*
layout: base.njk
---
{# This file defines the structure *within* the main content area of base.njk #}
<article class="post">
    {# Title comes from the individual post's front matter #}
    <h1>{{ title }}</h1>
    <p class="post-meta">
        {# Date comes from the post's front matter #}
        Published on {{ page.date | date('LLL dd, yyyy') }} {# Default Eleventy date filter format #}
        {# You can install luxon and use readableDate filter from .eleventy.js if needed #}
    </p>
    {# Description comes from the post's front matter #}
    {% if description %}
        <p class="post-description">
            {{ description }}
        </p>
    {% endif %}

    <div class="post-content">
        {# The actual Markdown content goes here #}
        {{ content | safe }}
    </div>
</article>
